@startuml casi_uso
title Osteria del Borgo - Diagramma dei casi d'uso dell'assistente
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F7F7F7
}
left to right direction

actor Cliente
actor "Personale\ndi sala" as Staff
actor "Modello linguistico\n(locale o cloud)" as LLM <<sistema>>

rectangle "Assistente virtuale Osteria del Borgo  (harness agentico + server MCP)" {
  package "Menu" {
    usecase "Consultare il menu" as M1
    usecase "Filtrare per allergeni\no vegetariano" as M2
    usecase "Vedere dettaglio piatto\n(ingredienti, allergeni)" as M3
  }
  package "Prenotazioni" {
    usecase "Verificare\ndisponibilità" as P1
    usecase "Prenotare un tavolo" as P2
    usecase "Cercare le proprie\nprenotazioni" as P3
    usecase "Modificare una\nprenotazione" as P4
    usecase "Cancellare una\nprenotazione" as P5
  }
  package "Asporto" {
    usecase "Ordinare da asporto" as O1
    usecase "Conoscere lo stato\ndi un ordine" as O2
  }
  package "Controlli trasversali" {
    usecase "Confermare l'operazione\n(human-in-the-loop)" as C1
    usecase "Verificare l'identità\n(telefono)" as C2
    usecase "Controllare le scorte" as C3
  }
}

Cliente --> M1
Cliente --> P1
Cliente --> P2
Cliente --> P3
Cliente --> P4
Cliente --> P5
Cliente --> O1
Cliente --> O2

M2 .> M1 : <<extend>>
M3 .> M1 : <<extend>>

P2 ..> C1 : <<include>>
P4 ..> C1 : <<include>>
P5 ..> C1 : <<include>>
O1 ..> C1 : <<include>>
P4 ..> C2 : <<include>>
P5 ..> C2 : <<include>>
O2 ..> C2 : <<include>>
O1 ..> C3 : <<include>>

Staff --> P3

M1 -- LLM
P2 -- LLM
O1 -- LLM

note right of C1
  Richiesta per ogni tool con
  readOnlyHint = false: il cliente
  vede un riepilogo e conferma [s/N].
end note
@enduml
