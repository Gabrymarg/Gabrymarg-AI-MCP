@startuml casi_uso
title Osteria del Borgo - Diagramma dei casi d'uso dell'assistente
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor Cliente
actor "Modello linguistico\n(Ollama)" as LLM <<sistema>>
actor "Personale di sala" as Staff

rectangle "Assistente virtuale (harness + server MCP)" {
  usecase "Consultare il menu" as UC1
  usecase "Filtrare per allergeni\n/ vegetariano" as UC2
  usecase "Vedere dettaglio piatto" as UC3
  usecase "Verificare disponibilità" as UC4
  usecase "Prenotare un tavolo" as UC5
  usecase "Cercare le proprie\nprenotazioni" as UC6
  usecase "Modificare una\nprenotazione" as UC7
  usecase "Cancellare una\nprenotazione" as UC8
  usecase "Ordinare da asporto" as UC9
  usecase "Conoscere lo stato\ndi un ordine" as UC10
  usecase "Confermare un'operazione\ndi scrittura" as UCC
  usecase "Verificare identità\n(telefono)" as UCV
  usecase "Controllare le scorte" as UCS
}

Cliente --> UC1
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Cliente --> UC7
Cliente --> UC8
Cliente --> UC9
Cliente --> UC10

UC2 .> UC1 : <<extend>>
UC3 .> UC1 : <<extend>>
UC5 .> UC4 : <<include>>
UC5 .> UCC : <<include>>
UC7 .> UCC : <<include>>
UC8 .> UCC : <<include>>
UC9 .> UCC : <<include>>
UC7 .> UCV : <<include>>
UC8 .> UCV : <<include>>
UC10 .> UCV : <<include>>
UC9 .> UCS : <<include>>

LLM -- UC1
LLM -- UC5
LLM -- UC9

Staff --> UC6 : consulta i dati\nregistrati
note right of UCC
  Human-in-the-loop: ogni tool con
  readOnlyHint = false richiede
  la conferma esplicita del cliente.
end note
@enduml
