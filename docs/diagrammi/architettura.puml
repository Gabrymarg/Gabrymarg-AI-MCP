@startuml architettura
title Architettura del sistema - componenti e flussi
skinparam shadowing false
skinparam componentStyle rectangle
skinparam nodesep 30
skinparam ranksep 45

actor "Utente\n(cliente, sala, cucina, admin)" as U

node "Browser" {
  [Pagina web\nHTML, CSS, JavaScript] as FE
}

node "Web app (FastAPI, porta 8000)" {
  [Autenticazione\nlogin, cookie HttpOnly,\nblocco tentativi] as AUTH
  [Gestore sessioni\nuna per utente] as SES
  [API amministrazione\nutenti e permessi,\nmenu e magazzino,\ncruscotto] as ADM
  [Storico delle\nconversazioni] as STO
  package "Harness agentico" {
    [Agent\nciclo, validazione,\nconferma, coerenza,\nverifica dei riferimenti,\ngestione contesto] as AG
    [LLMProvider\n+ router locale/cloud] as PROV
    [ClienteMCP\nHTTP + Bearer token] as CLI
    [LoggerJSONL] as LOG
  }
}

node "Server MCP (porta 8765)" {
  [Verifica token\n+ ruolo dal DB] as VER
  [18 tool\npermessi per ruolo\n(letti dal DB a ogni chiamata)] as TOOLS
}

node "Back-end" {
  [Servizi di dominio\nprenotazioni, menu, ordini,\nutenti, anagrafiche,\npermessi (con vincoli), storico] as SRV
  database "SQLite" as DB
}

cloud "Modelli linguistici" {
  [Ollama\nqwen2.5:3b (locale)] as OLL
  [Groq\ngpt-oss (cloud)] as GROQ
}

U --> FE
FE --> AUTH : login (HTTPS in produzione)
FE --> SES : chat (Server-Sent Events),\nconferme
FE --> ADM : solo admin
SES --> AG
SES --> STO : salva i messaggi
STO --> DB
AG --> PROV
PROV --> OLL
PROV --> GROQ
AG --> CLI
AG --> LOG
CLI --> VER : JSON-RPC su HTTP\nAuthorization: Bearer <token>
VER --> TOOLS
TOOLS --> SRV
SRV --> DB
AUTH --> DB : verifica password\n(hash scrypt)
ADM --> SRV : anagrafiche\n(categorie, ingredienti,\narticoli)
ADM --> DB : utenti

note bottom of TOOLS
  Difesa in profondità:
  1. l'harness mostra al modello solo i tool del ruolo;
  2. il server verifica il permesso a ogni chiamata;
  3. il back-end applica la proprietà dei dati
     (un cliente vede solo i propri);
  4. ogni scrittura richiede la conferma dell'utente.
end note
@enduml
