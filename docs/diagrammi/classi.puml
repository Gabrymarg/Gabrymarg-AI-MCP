@startuml classi
title Diagramma delle classi (1/2) - harness agentico
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
left to right direction

class Agent {
  - llm : LLMProvider
  - esecutore : EsecutoreTool
  - conferma : FunzioneConferma
  - log : LoggerJSONL
  - cfg : Config
  - strumenti : dict<str, ToolSpec>
  - validatori : dict<str, Draft202012Validator>
  - messaggi : list<Messaggio>
  - uso_sessione : Uso
  + avvia() <<async>>
  + esegui_turno(testo : str) : EsitoTurno <<async>>
  + nuova_conversazione()
  - _esegui_chiamata(c : ToolCall, iterazione : int) : dict <<async>>
}

class Config {
  provider : str
  modello : str
  max_iterazioni : int = 8
  max_errori_consecutivi : int = 3
  max_ripetizioni_chiamata : int = 2
  timeout_tool_s : float = 15
  guardrail_coerenza : bool = true
}

class EsitoTurno {
  risposta : str
  motivo_arresto : str
  iterazioni : int
  uso : Uso
  tool_invocati : list<str>
  durata_ms : int
}

interface EsecutoreTool <<Protocol>> {
  + elenco_strumenti() : list<ToolSpec>
  + chiama(nome, argomenti, timeout_s) : EsitoTool
}

class ClienteMCP {
  - parametri : StdioServerParameters
  - _client : mcp.Client
  + elenco_strumenti() : list<ToolSpec>
  + chiama(nome, argomenti, timeout_s) : EsitoTool
}

class EsitoTool {
  ok : bool
  contenuto : Any
  errore : dict
}

class LoggerJSONL {
  id_sessione : str
  percorso : Path
  + registra(tipo, turno, iterazione, **dati)
  + chiudi()
}

package "moduli di controllo" <<Rectangle>> {
  class confirm <<module>> {
    + conferma_interattiva(spec, argomenti) : bool
    + riepilogo(spec, argomenti) : str
  }
  class guardrail <<module>> {
    + afferma_operazione(testo) : bool
  }
  class tool_testuali <<module>> {
    + estrai(testo, nomi_tool) : (stato, ToolCall)
    + pulisci_risposta(testo) : str
  }
  class schema_utils <<module>> {
    + compatta_schema(schema) : dict
    + converti_argomenti(argomenti, schema) : dict
  }
}

package "harness.llm" <<Rectangle>> {
  abstract class LLMProvider {
    + nome : str
    + modello : str
    + {abstract} chat(messaggi, strumenti) : LLMResponse
  }
  class OllamaProvider {
    + chat(messaggi, strumenti) : LLMResponse
  }
  class OpenAICompatibileProvider {
    - base_url : str
    - max_tentativi : int
    + chat(messaggi, strumenti) : LLMResponse
    - _post_con_riprova(corpo)
  }
  class GroqProvider
  class MockProvider {
    - copione : list
    + chat(messaggi, strumenti) : LLMResponse
  }
  class Messaggio {
    ruolo : str
    contenuto : str
    tool_calls : list<ToolCall>
  }
  class ToolCall {
    id : str
    nome : str
    argomenti : dict
  }
  class ToolSpec {
    nome : str
    parametri : JSONSchema
    scrittura : bool
    distruttivo : bool
  }
  class LLMResponse {
    testo : str
    tool_calls : list<ToolCall>
    uso : Uso
  }
  class Uso {
    token_input : int
    token_output : int
  }
}

LLMProvider <|-- OllamaProvider
LLMProvider <|-- OpenAICompatibileProvider
OpenAICompatibileProvider <|-- GroqProvider
LLMProvider <|-- MockProvider
EsecutoreTool <|.. ClienteMCP

Agent o--> LLMProvider
Agent o--> EsecutoreTool
Agent o--> LoggerJSONL
Agent --> Config
Agent ..> EsitoTurno : crea
Agent ..> confirm
Agent ..> guardrail
Agent ..> tool_testuali
Agent ..> schema_utils
Agent "1" *-- "*" Messaggio
Agent "1" o-- "*" ToolSpec
Messaggio *-- "*" ToolCall
LLMResponse *-- Uso
LLMProvider ..> LLMResponse
ClienteMCP ..> EsitoTool
@enduml
