@startuml classi_server
title Diagramma delle classi (2/2) - server MCP e back-end
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
allowmixing

package "mcp_server" <<Rectangle>> {
  class server <<module>> {
    mcp : MCPServer
    .. tool di lettura (readOnlyHint = true) ..
    + mio_profilo() : Profilo
    + orari_apertura() : OrariApertura
    + cerca_menu(testo, categoria, escludi_allergeni, ...) : RisultatoMenu
    + dettaglio_piatto(nome, id_articolo) : DettaglioPiatto
    + verifica_disponibilita(data, ora, coperti) : Disponibilita
    + orari_disponibili(data, coperti) : OrariDisponibili
    + trova_prenotazioni(nome, telefono, data) : ElencoPrenotazioni
    + prenotazioni_del_giorno(data) : QuadroSala
    + stato_ordine(id_ordine, telefono) : Ordine
    + ordini_da_preparare(data) : ElencoOrdini
    + giacenze_ingredienti(testo, solo_sotto_scorta) : Giacenze
    .. tool di scrittura (readOnlyHint = false) ..
    + crea_prenotazione(...) : Prenotazione
    + modifica_prenotazione(...) : Prenotazione
    + cancella_prenotazione(id, telefono) : Prenotazione <<destructive>>
    + crea_ordine_asporto(...) : Ordine
    + aggiorna_stato_ordine(id, nuovo_stato) : Ordine
    + aggiorna_scorta(ingrediente, quantita, modalita) : EsitoScorta
    + imposta_disponibilita_piatto(nome, disponibile) : DisponibilitaPiatto
    .. ..
    - tool_protetto(fn) <<decorator>>
    - _identita() : Utente
  }
  class VerificatoreToken {
    + verify_token(token) : AccessToken
  }
  class schemas <<module, Pydantic>> {
    RisultatoMenu, Piatto, DettaglioPiatto
    Disponibilita, OrariDisponibili, Prenotazione
    ElencoPrenotazioni, QuadroSala, RigaOrdineIn
    Ordine, RigaOrdine, ElencoOrdini, OrariApertura
    Profilo, Giacenze, EsitoScorta, DisponibilitaPiatto
  }
}

package "backend" <<Rectangle>> {
  class prenotazioni <<module>> {
    + verifica_disponibilita(conn, data, ora, coperti)
    + crea_prenotazione(conn, ...)
    + trova_prenotazioni(conn, ...)
    + modifica_prenotazione(conn, ...)
    + cancella_prenotazione(conn, id, telefono)
  }
  class menu <<module>> {
    + cerca_menu(conn, ...)
    + dettaglio_piatto(conn, id_articolo, nome)
    + trova_piatto(conn, nome) : int
    + porzioni_disponibili(conn, id) : int
    + giacenze_ingredienti(conn, testo, solo_sotto_scorta)
  }
  class anagrafiche <<module>> {
    + salva_categoria / elimina_categoria
    + salva_ingrediente / elimina_ingrediente
    + salva_articolo(conn, ..., allergeni, ricetta)
  }
  class ordini <<module>> {
    + crea_ordine_asporto(conn, ...)
    + stato_ordine(conn, id, telefono)
  }
  class validazione <<module>> {
    + parse_data(valore) : date
    + parse_ora(valore) : time
    + normalizza_telefono(valore) : str
  }
  class clock <<module>> {
    + adesso() : datetime
  }
  class db <<module>> {
    + connessione() : Connection
  }
  class ErroreDominio {
    codice : str
    messaggio : str
    dettagli : dict
  }
  class permessi <<module>> {
    PERMESSI_PREDEFINITI : dict<tool, set<ruolo>>
    SOLO_PERSONALE, SEMPRE_CONSENTITI : vincoli
    + carica(conn) : dict  <<dal DB, vincoli riapplicati>>
    + puo(ruolo, tool, tabella) : bool
    + tool_consentiti(ruolo, tabella) : list
    + imposta(conn, admin, ruolo, tool, consentito)
    + ripristina(conn, admin)
    + registro(conn) : list
  }
  class storico <<module>> {
    + nuova(conn, id_utente, testo) : int
    + aggiungi(conn, id, ruolo, testo)
    + elenco(conn, utente, tutte) : list
    + leggi(conn, id, utente, per_riprendere)
    + elimina(conn, id, utente)
  }
  class Utente {
    id_utente : int
    ruolo : str
    nome : str
    telefono : str
    personale() : bool
    cliente_registrato() : bool
  }
  class utenti <<module>> {
    + hash_password(pwd) : str
    + autentica(conn, username, pwd) : Utente
    + utente_attivo(conn, id) : Utente
    + crea_utente(...) / modifica_utente(...)
  }
  class token_accesso <<module>> {
    + emetti(id_utente, ruolo) : str
    + verifica(token) : dict
  }
}

VerificatoreToken ..> token_accesso
VerificatoreToken ..> utenti : ruolo attuale dal DB
server ..> VerificatoreToken
server ..> permessi : controllo a ogni tool
server ..> Utente
prenotazioni ..> Utente : proprietà dei dati
ordini ..> Utente
permessi ..> Utente
storico ..> Utente : proprietario o admin (sola lettura)

database "SQLite\n(risto.db)" as DB

server ..> schemas
server ..> prenotazioni
server ..> menu
server ..> ordini
server ..> db
server ..> ErroreDominio : converte in ToolError
prenotazioni ..> validazione
ordini ..> validazione
ordini ..> menu
prenotazioni ..> clock
ordini ..> clock
prenotazioni ..> ErroreDominio
menu ..> ErroreDominio
ordini ..> ErroreDominio
db --> DB
@enduml
